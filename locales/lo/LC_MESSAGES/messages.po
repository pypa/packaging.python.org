msgstr "ຊື່ tag, ຊື່ branch, changeset ID."

#: ../source/specifications/direct-url-data-structure.rst:193
msgid "A changeset ID (40 hexadecimal characters)."
msgstr "changeset ID (ຕົວອັກສອນເລກຖານສິບຫົກ 40 ຕົວ)."

