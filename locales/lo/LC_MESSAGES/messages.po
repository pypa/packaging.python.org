#: ../source/specifications/build-details/v1.0.rst:12
msgid "**version**"
msgstr "**version**"

#: ../source/specifications/build-details/v1.0.rst:12
msgid ""
"String representation the Python language version — a version string "
"consisting only of the *major* and *minor* components."
msgstr "ສະຕຣິງແທນເວີຊັນພາສາ Python."

