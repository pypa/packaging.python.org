#: ../source/specifications/build-details/v1.0.rst:12
msgid "**platform**"
msgstr "**platform**"

#: ../source/specifications/build-details/v1.0.rst:12
msgid "System platform string."
msgstr "系统平台字符串。"

#: ../source/specifications/build-details/v1.0.rst:12
msgid "This field **SHOULD** be equivalent to ``sysconfig.get_platform()``."
msgstr "此字段 **应该** 等价于 ``sysconfig.get_platform()``。"

